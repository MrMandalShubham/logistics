# ============================================================
# Production environment — Logistics Core
#
# Copy this, fill it in, and paste THAT into Vercel. Do not import
# `.env`: it points at a Docker container on your laptop and is
# missing a secret the status push cannot work without.
#
# ── Read this first: Vercel cannot run all of it ──
#
# The API and the screens deploy to Vercel happily. The WORKER does
# not, and must not:
#
#   npm run worker
#
# It drains the outbound queue, expires assignments and holds, and
# runs retention. A serverless function is billed by wall-clock and
# killed mid-flight; a job terminated between "claimed a queue row"
# and "recorded what happened to it" manufactures the exact crash the
# SENDING state exists to survive, every twenty seconds.
#
# Put it on a small always-on host — Railway, Render, Fly, a VM, a
# container. It needs this same file. If it is not running, NOTHING
# is sent to Inventory or Grocery, and `/api/health?deep=1` returns
# 503 naming the job.
# ============================================================

# ── The database ──
#
# Logistics has its OWN Postgres. It is not Grocery's Supabase
# project and must not be pointed at it: two systems sharing one
# database is how you end up with two sources of truth.
#
# Use a POOLED connection string. Vercel creates a new Node instance
# per concurrent request, each with its own pg pool, and a direct
# connection limit is reached surprisingly fast.
#   Supabase: Project Settings -> Database -> Connection string
#             -> "Transaction pooler" (port 6543) for the API
#             -> "Session pooler"     (port 5432) for the worker and migrations
DATABASE_URL=

# Per-instance pool size. Small on serverless and NOT the local 8:
# this is multiplied by however many instances Vercel has warm.
PG_POOL_MAX=2

# ── Inventory Core ──
#
# A key here can hold, consume and release real stock.
INVENTORY_API_URL=
INVENTORY_API_KEY=

# ── Grocery ──
#
# Where the customer's order lives. The status push goes to
# {GROCERY_BASE_URL}/api/logistics/status.
#
# NOTE: if Vercel Deployment Protection is on for Grocery, this URL
# answers 302 to an SSO page and every status push will 401 and
# dead-letter. Turn protection off for production, or add a bypass.
GROCERY_BASE_URL=

# ── The two webhook secrets ──
#
# One per direction, deliberately, so a leak in one cannot be used in
# the other and either rotates alone. They are NOT interchangeable
# and it is easy to mistake that for a typo.
#
#   Grocery  -> Logistics   Grocery signs with LOGISTICS_WEBHOOK_SECRET
#                           we verify with INBOUND_WEBHOOK_SECRET
#
#   Logistics -> Grocery    we sign with GROCERY_WEBHOOK_SECRET
#                           Grocery verifies with LOGISTICS_INBOUND_SECRET
#
# Generate each with:  openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=
GROCERY_WEBHOOK_SECRET=

# ── Password hashing ──
#
# Changing N invalidates nothing — the parameters are stored with
# each hash — but raising it makes every sign-in slower. 16384 is a
# sensible floor; 32768 is better if your host can afford ~100 ms.
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1

# ── Sessions ──
#
# Riders get a week because they work from a phone all day; staff get
# twelve hours because they work from a shared desk.
SESSION_TTL_STAFF_SECONDS=43200
SESSION_TTL_RIDER_SECONDS=604800

LOG_LEVEL=info

# ============================================================
# NOT in production. These are development-only and importing them
# is at best noise and at worst dangerous:
#
#   DEMO_API_KEY       seeds a fake Grocery client for demo:order
#   LOGISTICS_BASE_URL only read by demo-order.mjs
#   PG_CONTAINER       names a local Docker container
#   ALLOW_DESTRUCTIVE  lets db:reset empty a database
#   P6_SKU, SECRET     used by the live-check scripts and the stub
# ============================================================
