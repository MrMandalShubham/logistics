# ── Database ──
#
# Local development uses the container from `npm run db:up` on port
# 55433 — chosen so it cannot collide with a system Postgres (5432)
# or with Inventory's container (55432).
#
# In production use the Supabase POOLER host:
#   aws-0-<region>.pooler.supabase.com:6543
# NOT db.<ref>.supabase.co:5432, which has an AAAA record and no A
# record. It is IPv6-only and does not resolve from a serverless
# function at all — every request fails with ENOTFOUND. Inventory
# learned this by breaking a deploy; there is no reason to learn it
# twice.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/logistics_core

# Connections per process. Keep it small: the wrapper uses exactly one
# per request and returns it before responding.
PG_POOL_MAX=8

# ── Inventory Core ──
#
# Phase 1 reads locations and nothing else, so the key needs
# `catalog:read` and NOTHING MORE — GET /api/locations is guarded by
# catalog:read, not stock:read (verified against a running Inventory).
# reservations:write is not required until Phase 2 introduces
# confirm/commit/release; granting it now would widen the blast radius
# of a leak for no benefit today.
#
# Mint it on the Inventory deployment as an admin:
#   select api_key from platform.create_api_client(
#     'Logistics Core', ARRAY['catalog:read'], '{}', 'LIVE');
#
# Unset is a supported state: the location cache falls back to a seed
# fixture and deep health reports `inventory: not_configured`.
# INVENTORY_API_URL=http://localhost:3100
# INVENTORY_API_KEY=ic_live_...

# ── Grocery ──
#
# Phase 1 only probes that Grocery is up, so an operator sees both
# halves of the estate on one health screen.
#
# Grocery exposes no HTTP API today (there is no app/api directory in
# that repository), so there is nothing else to configure yet. The
# ingest and status-push settings arrive in Phase 2, once open
# questions Q1 and Q3 are answered.
# GROCERY_BASE_URL=http://localhost:3000

# ── Password hashing ──
#
# scrypt from node:crypto. N is the CPU/memory cost and the process
# REFUSES TO START below 16384 — hashing passwords weakly is the kind
# of mistake you only discover after a breach.
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1

# ── Sessions ──
#
# Staff sign in for a working day; riders for a working week, because
# re-authenticating on a phone mid-shift in the rain is how people end
# up sharing logins.
SESSION_TTL_STAFF_SECONDS=43200
SESSION_TTL_RIDER_SECONDS=604800

# ── Logging ──
#
# debug | info | warn | error. Secrets are redacted and personal
# fields masked at every level — see lib/logging.ts.
LOG_LEVEL=info

# ── Safety ──
#
# db:reset refuses a non-local DATABASE_URL unless this is true.
# Emptying the wrong database should require setting the wrong
# variable, not merely forgetting which one it is.
# ALLOW_DESTRUCTIVE=false

# ── Inbound webhook (Phase 2) ──
#
# The shared secret Grocery signs delivery-ready orders with. The
# signature covers `<unix seconds>.<raw body>`, so a captured request
# stops being valid after 300 seconds — the timestamp is inside the
# MAC and cannot be edited.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INBOUND_WEBHOOK_SECRET=

# For `npm run demo:order` only — a key holding orders:ingest.
#   npm run key:mint -- "Grocery storefront" orders:ingest,deliveries:read
# DEMO_API_KEY=lg_live_...
# LOGISTICS_BASE_URL=http://127.0.0.1:3200

# ── Pushing delivery status to Grocery (Phase 5) ──
#
# Where the customer's order lives. Without these, status events queue
# up and retry rather than dying, so nothing is lost while it is
# unconfigured.
# GROCERY_BASE_URL is already set above for the health check.
#
# Must equal LOGISTICS_INBOUND_SECRET on the Grocery deployment. It is
# a DIFFERENT secret from INBOUND_WEBHOOK_SECRET, which verifies
# traffic coming the other way: one secret per direction, so a leak in
# one cannot be used in the other and either rotates alone.
GROCERY_WEBHOOK_SECRET=
